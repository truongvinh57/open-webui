# deploy/custom/.env — copy to `.env` and fill secrets (gitignored).
# Public host: https://ai-dev.newtecons.vn

# Core
WEBUI_SECRET_KEY=
WEBUI_URL=https://ai-dev.newtecons.vn
WEBUI_NAME=Newtecons AI
ENV=prod
PORT=8080
UVICORN_WORKERS=8
ENABLE_DB_MIGRATIONS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false
SCARF_NO_ANALYTICS=true

# Database
DB_PASSWORD=
# Use the container name, not the bare service name `postgres`: the container
# also joins the external `ntc-rag` network where `postgres` resolves to the
# NTC-RAG database service.
DATABASE_URL=postgresql://webui:${DB_PASSWORD}@open-webui-postgres-1:5432/openwebui
DATABASE_POOL_SIZE=15
DATABASE_POOL_MAX_OVERFLOW=20
VECTOR_DB=pgvector
PGVECTOR_DB_URL=postgresql://webui:${DB_PASSWORD}@open-webui-postgres-1:5432/openwebui
PGVECTOR_INITIALIZE_MAX_VECTOR_LENGTH=1536
PGVECTOR_USE_HALFVEC=false
PGVECTOR_PGCRYPTO=false

# Redis / websocket
REDIS_PASSWORD=
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
WEBSOCKET_MANAGER=redis
ENABLE_WEBSOCKET_SUPPORT=true
WEBSOCKET_SERVER_PING_INTERVAL=25
WEBSOCKET_SERVER_PING_TIMEOUT=300
WEBSOCKET_EVENT_CALLER_TIMEOUT=300
WEBSOCKET_REDIS_OPTIONS={"socket_timeout": null, "socket_connect_timeout": 10}

# Session / CORS / audit
WEBUI_SESSION_COOKIE_SECURE=true
WEBUI_SESSION_COOKIE_SAME_SITE=lax
CORS_ALLOW_ORIGIN=https://ai-dev.newtecons.vn
AUDIT_LOG_LEVEL=METADATA
ENABLE_AUDIT_LOGS_FILE=true
AUDIT_LOGS_FILE_PATH=/app/backend/data/audit.log

# Auth / SSO
ENABLE_SIGNUP=false
ENABLE_LOGIN_FORM=true
ENABLE_API_KEYS=true
JWT_EXPIRES_IN=4w
ENABLE_OAUTH_SIGNUP=true
OAUTH_MERGE_ACCOUNTS_BY_EMAIL=true
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OPENID_PROVIDER_URL=https://sso.newtecons.vn/realms/Newtecons/.well-known/openid-configuration
OPENID_REDIRECT_URI=https://ai-dev.newtecons.vn/oauth/oidc/callback
OAUTH_PROVIDER_NAME=Newtecons SSO
OAUTH_SCOPES=openid email profile offline_access

# LLM proxy
ENABLE_OPENAI_API=true
OPENAI_API_BASE_URLS=http://proxy:4000/v1
OPENAI_API_KEYS=
ENABLE_OLLAMA_API=false
CHAT_RESPONSE_MAX_TOOL_CALL_ITERATIONS=14

# Native RAG / retrieval
ENABLE_KB_EXEC=false
BYPASS_EMBEDDING_AND_RETRIEVAL=false
RAG_EMBEDDING_ENGINE=openai
RAG_OPENAI_API_BASE_URL=http://proxy:4000/v1
RAG_OPENAI_API_KEY=
RAG_EMBEDDING_MODEL=bge-m3
RAG_EMBEDDING_BATCH_SIZE=32
ENABLE_RAG_HYBRID_SEARCH=true
ENABLE_RAG_HYBRID_SEARCH_ENRICHED_TEXTS=true
RAG_HYBRID_BM25_WEIGHT=0.4
RAG_RERANKING_ENGINE=external
RAG_RERANKING_MODEL=bge-reranker-v2-m3
RAG_EXTERNAL_RERANKER_URL=http://proxy:4000/v1/rerank
RAG_EXTERNAL_RERANKER_API_KEY=
RAG_RERANKING_BATCH_SIZE=32
RAG_TOP_K=5
RAG_TOP_K_RERANKER=10
RAG_RELEVANCE_THRESHOLD=0.3
CHUNK_SIZE=1500
CHUNK_OVERLAP=200
CHUNK_MIN_SIZE_TARGET=200
ENABLE_MARKDOWN_HEADER_TEXT_SPLITTER=true
CONTENT_EXTRACTION_ENGINE=mineru
MINERU_API_URL=http://router:8002

# Open Terminal — upstream default sidecar, no custom patch.
OPEN_TERMINAL_API_KEY=

# Native sub-agents (0.11) replace the retired custom sub_agent tool.
ENABLE_SUBAGENTS=true

# Read-only connection to the LiteLLM database for the NTC Usage Guard
# budget pre-check and daily USD usage display.
LITELLM_DATABASE_URL=

# Web search
ENABLE_WEB_SEARCH=true
WEB_SEARCH_ENGINE=firecrawl
WEB_SEARCH_RESULT_COUNT=5
WEB_LOADER_ENGINE=firecrawl
FIRECRAWL_API_BASE_URL=http://firecrawl-api:3002
FIRECRAWL_API_KEY=

# Native context compaction
ENABLE_CONTEXT_COMPACTION=true
CONTEXT_COMPACTION_TOKEN_THRESHOLD=80000

# Telemetry / tracing
ENABLE_OTEL=false
